{
  "name": "dsh-phone-home",
  "version": "0.1.0",
  "description": "iOS home-screen fix plugin for DeepSeek Harness remote access: points the PWA manifest start_url at /pair-app so the home-screen icon stops hitting the harness 401, and serves home-screen icons. Watchdog scripts and docs live in the same repository.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "assets/**",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "pwa",
    "ios",
    "remote-access",
    "start_url",
    "cordis-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/David060323/dsh-phone-remote.git"
  }
}